// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SECTION: Core (auth, users, RBAC)
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  avatarUrl          String?   @map("avatar_url")
  privacyAcceptedAt  DateTime? @map("privacy_accepted_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  userRoles             UserRole[]
  userPermissions       UserPermission[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  gameSessions          GameSession[]
  sessionParticipations SessionParticipant[]
  communityNotices      CommunityNotice[]
  memorialProfiles      MemorialProfile[]
  events                Event[]
  eventQuotaRequests    EventQuotaRequest[]

  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String @map("user_id")
  permissionId String @map("permission_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ============================================================
// SECTION: Adventure Module
// ============================================================

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       Json
  description String?
  chapter     Int      @default(1)
  nextGameId  String?  @unique @map("next_game_id")
  isActive    Boolean  @default(false) @map("is_active")
  // Array of { id, flag, name: {en,it,es}, imageUrl? }
  items       Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  locations GameLocation[]
  sessions  GameSession[]

  @@map("games")
}

model GameLocation {
  id          String @id @default(cuid())
  gameId      String @map("game_id")
  externalId  String @map("external_id")
  name        Json
  lat         Float
  lng         Float
  radiusM     Int    @default(35) @map("radius_m")
  // null | "flag_string" | { and: Condition[] } | { or: Condition[] }
  visibleWhen Json?  @map("visible_when")
  // Array of { when: Condition | null, content: { en, it, es }, completesChapter?: true }
  values      Json
  // "location" (default) | "event" — events auto-fire on radius entry, no sheet
  type        String  @default("location")
  imageUrl    String? @map("image_url")
  // Array of { flag: string }
  grants      Json
  // Array of { flag: string } — flags removed from session on visit
  revokes     Json   @default("[]")
  order           Int     @default(0)
  // True on the one location where the player should start (used by fake GPS to teleport)
  initialLocation Boolean @default(false) @map("initial_location")

  game   Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  visits LocationVisit[]

  @@unique([gameId, externalId])
  @@index([gameId])
  @@map("game_locations")
}

model GameSession {
  id          String    @id @default(cuid())
  gameId      String    @map("game_id")
  userId      String    @map("user_id")
  joinCode    String?   @unique @map("join_code")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  game         Game                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  flags        SessionFlag[]
  visits       LocationVisit[]
  participants SessionParticipant[]

  @@unique([gameId, userId])
  @@index([userId])
  @@map("game_sessions")
}

model SessionParticipant {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("session_participants")
}

model SessionFlag {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  flag      String
  setAt     DateTime    @default(now()) @map("set_at")

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, flag])
  @@index([sessionId])
  @@map("session_flags")
}

model LocationVisit {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  locationId String   @map("location_id")
  status     String   @default("open")
  visitedAt  DateTime @default(now()) @map("visited_at")
  // Index of the location value the player saw when last closing it. Used to
  // re-brighten the marker (unvisited color) when the resolved state later
  // changes due to new flags. Null until the location has been closed once.
  seenValueIndex Int? @map("seen_value_index")

  session  GameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  location GameLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, locationId])
  @@index([sessionId])
  @@map("location_visits")
}

// ============================================================
// SECTION: Community module (municipal notices)
// ============================================================

enum CommunityNoticeStatus {
  open
  fixed
}

model CommunityNotice {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  category   String // category key (free string — see modules/community/lib/categories.ts)
  lat        Float
  lng        Float
  note       String?   @db.VarChar(280)
  photoUrl   String?   @map("photo_url")
  status     CommunityNoticeStatus @default(open)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  resolvedAt DateTime? @map("resolved_at")

  // Set when a volunteer marks the notice fixed (before/after photos required).
  fixedAt        DateTime? @map("fixed_at")
  fixedByUserId  String?   @map("fixed_by_user_id")
  beforePhotoUrl String?   @map("before_photo_url")
  afterPhotoUrl  String?   @map("after_photo_url")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("community_notices")
}

// ============================================================
// SECTION: Associations (Contact an association)
// ============================================================

// Curated directory of Valenza volunteer/civic associations. Read is public;
// create/update/delete are admin-only (associations:manage). Seeded from
// modules/associations/lib/seedData.ts — `name` is unique so the seed upserts
// idempotently. Contact fields are all optional; the client shows a single
// "preferred" contact (website > facebook > instagram > email — see
// modules/associations/lib/contact.ts). Entries without lat/lng still appear in
// the list, just not on the map.
model Association {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // true = in the official Comune di Valenza register; false = other local
  // association added to the broader directory (shown under its own heading).
  official    Boolean  @default(true)
  // Codice Fiscale / registration number (public for orgs, used to verify on
  // RUNTS). Stored for records only — deliberately NOT returned by any public
  // API select, so it isn't published in the directory.
  taxCode     String?  @map("tax_code")
  website     String?
  facebook    String?
  instagram   String?
  email       String?
  phone       String?
  address     String?
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("associations")
}

// ============================================================
// SECTION: Memories (commemorative profiles)
// ============================================================

// A commemorative profile for a deceased person, owned by the creator. The
// public page lives at /memories/<slug>; the owner edits it and exports a QR
// (to that public URL) as a PDF. Any logged-in user can create one; profiles
// are public immediately (no draft state in v1). See modules/memories/.
model MemorialProfile {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") // owner
  name      String // the person being remembered
  subtitle  String? // optional one-line tagline (e.g. "Beloved father and teacher")
  slug      String   @unique // public URL segment
  facebook  String?
  instagram String?
  tiktok    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts MemorialPost[]

  @@index([userId])
  @@map("memorial_profiles")
}

// A single life-story entry on a memorial profile: rich text (Tiptap JSON),
// an ordered image carousel (R2 URLs), and an optional location (label + coords
// for a future map). `position` controls display order within the profile.
model MemorialPost {
  id            String   @id @default(cuid())
  profileId     String   @map("profile_id")
  content       Json // Tiptap document JSON (safe, constrained node set)
  images        String[] @default([]) // ordered R2 public URLs (carousel)
  locationLabel String?  @map("location_label")
  lat           Float?
  lng           Float?
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profile MemorialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("memorial_posts")
}

// ============================================================
// SECTION: Events (community events board)
// ============================================================

enum EventRequestStatus {
  pending
  approved
  denied
}

// A community event published by a user. Non-admins may publish 1 per rolling
// 7 days; admins and holders of `events:unlimited` bypass the cap. Public to
// read at /events; owner (or admin) edits. Rich text is the shared Tiptap
// document (see lib/richtext). Images only (presigned direct-to-R2) — no video.
model Event {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  title         String
  type          String // category key — see modules/events/lib/categories.ts
  content       Json // Tiptap document JSON (shared rich text)
  images        String[]  @default([]) // ordered R2 object keys (carousel)
  startAt       DateTime  @map("start_at")
  endAt         DateTime? @map("end_at")
  locationLabel String?   @map("location_label")
  lat           Float?
  lng           Float?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startAt])
  @@map("events")
}

// A user's request to publish more than the weekly limit. Admins review these
// in the admin panel; approving grants the user the `events:unlimited`
// permission. reviewedByUserId is a plain id (no FK) — just an audit note.
model EventQuotaRequest {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  message          String?
  status           EventRequestStatus @default(pending)
  reviewedByUserId String?            @map("reviewed_by_user_id")
  reviewedAt       DateTime?          @map("reviewed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("event_quota_requests")
}
